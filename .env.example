# ============================================================
# .env.example — VALORES DE EJEMPLO (NO USAR EN PRODUCCIÓN)
# ============================================================
# Copia este archivo como ".env" y rellena tus propios valores.
# NUNCA subas tu .env real a Git ni lo compartas públicamente.
# ============================================================

# --- Firebase (autenticación de usuarios) ---
# Obtén estos valores en: https://console.firebase.google.com
# Proyecto > Configuración > Tu app web
FIREBASE_API_KEY=TU_API_KEY_AQUI
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef000000

# --- Stripe (pagos) ---
# IMPORTANTE: Las claves de Stripe NUNCA deben ir en el frontend.
# Úsalas exclusivamente en tu servidor (Node.js, Cloudflare Workers, etc.)
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REEMPLAZA_CON_TU_CLAVE_SECRETA
STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZA_CON_TU_CLAVE_PUBLICA
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA_CON_TU_WEBHOOK_SECRET

# --- Email (notificaciones) ---
# Proveedor recomendado: Brevo (ex Sendinblue), SendGrid, Resend
# Obtén tu clave en: https://app.brevo.com o https://app.sendgrid.com
EMAIL_API_KEY=TU_CLAVE_DE_EMAIL_AQUI
EMAIL_FROM=noreply@tudominio.com
EMAIL_FROM_NAME=Tu Marca

# --- Base de datos (opcional, si añades backend propio) ---
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/tu_base_de_datos

# --- Sesión del servidor (genera un valor aleatorio seguro) ---
# Puedes generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CAMBIA_ESTO_POR_UN_VALOR_ALEATORIO_SEGURO_DE_32_BYTES

# --- Dominio de producción ---
PUBLIC_URL=https://tudominio.com
